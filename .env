# PostgreSQL Configuration
# These environment variables are loaded by docker-compose.yml

# PostgreSQL superuser password
# CHANGE THIS TO A STRONG PASSWORD IN PRODUCTION
POSTGRES_PASSWORD=postgres

# Database name to create on first startup
POSTGRES_DB=leapvengersdb

# PostgreSQL superuser name
POSTGRES_USER=postgres

# Port to expose PostgreSQL on the host machine
# Change to a different port if 5432 is already in use
POSTGRES_PORT=5432
