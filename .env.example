# LEAPvengers settings for docker compose (docker-compose.yml).
# Copy to .env and change what you need:  Copy-Item .env.example .env
# Every setting has a working local default, so .env is optional. .env is gitignored; never commit secrets.
# On AWS these values come from AWS Secrets Manager and the CloudFormation stacks instead (deploy/aws/README.md).

# Database (the leapdb container)
POSTGRES_DB=leapvengersdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-locally
# Host port for the database; use 5433 if PostgreSQL is already installed and running on this machine
DB_PORT=5432

# Signs sign-in tokens. Any long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-string

# Optional: live exchange rates for the display currency in Settings (allratestoday.com). Without it the app uses
# built-in rates.
EXCHANGE_RATE_API_KEY=

# Where the app is served: http://localhost:8080 (API also on http://localhost:8081/api)
APP_PORT=8080
API_PORT=8081

# Prices: live (real Yahoo Finance quotes) or simulated (offline random walk, labelled SIMULATED)
QUOTE_SOURCE=live
# For a demo outside market hours: QUOTE_SOURCE=simulated, QUOTE_ALL_HOURS=true, ENFORCE_MARKET_HOURS=false
QUOTE_ALL_HOURS=false
ENFORCE_MARKET_HOURS=true

# true makes db-init wipe and rebuild the database on the next start (all data is lost); set it back to false after
RESET_DATABASE=false
